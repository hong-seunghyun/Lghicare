{
  "name": "lg",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider --max-old-space-size=4096 next dev",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider --max-old-space-size=4096 next build",
    "start": "cross-env NODE_OPTIONS=--openssl-legacy-provider --max-old-space-size=4096 next start -p $PORT",
    "lint": "eslint",
    "export": "next export",
    "build:ssr": "npm run build && powershell -Command \"Remove-Item -Recurse -Force functions/.next; cp -r .next functions/\"",
    "deploy:ssr": "npm run build && firebase deploy --only hosting",
    "deploy:gcloud": "gcloud builds submit --config cloudbuild.yaml --machine-type=n1-highcpu-32 --disk-size=100 .",
    "deploy:run": "gcloud run deploy nextapp --image gcr.io/lghicare-861b3/nextapp --region us-central1 --platform managed --allow-unauthenticated",
    "deploy:firebase": "firebase deploy --only hosting",
    "deploy:all": "npm run deploy:gcloud && npm run deploy:run && firebase deploy --only hosting"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "firebase": "^12.4.0",
    "firebase-functions-test": "^3.4.1",
    "googleapis": "^160.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.3",
    "lottie-react": "^2.4.1",
    "next": "^15.5.4",
    "next-auth": "^4.24.11",
    "p-limit": "^7.1.1",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^4.10.38",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-helmet-async": "^2.0.5",
    "react-quill": "^2.0.0",
    "recharts": "^3.5.1",
    "styled-components": "^6.1.19",
    "swiper": "^12.0.2",
    "swr": "^2.3.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/styled-components": "^5.1.34",
    "cross-env": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.3",
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^6.4.0",
    "firebase-tools": "^14.17.0",
    "typescript": "^5"
  }
}
